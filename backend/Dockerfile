# ============================================================
# HELPDESK.AI — backend/Dockerfile (shim)
# ============================================================
# The canonical Dockerfile lives at the repo root: ../Dockerfile
#
# This file exists only for tooling that assumes a Dockerfile
# inside the backend/ directory (e.g. some CI systems, IDE
# Docker extensions). It is intentionally minimal — it delegates
# all logic to the root Dockerfile via build context.
#
# To build the backend image, always run from the REPO ROOT:
#
#   docker build -t helpdesk-ai-backend .
#   docker build --target development -t helpdesk-ai-dev .
#   docker build --target production  -t helpdesk-ai-prod .
#
# Do NOT edit this file to add build steps — edit ../Dockerfile.
# ============================================================

# Build-arg lets CI pass which stage to build without changing this file.
ARG BUILD_TARGET=production

# The actual build is driven by the root Dockerfile.
# When using this file directly (build context = backend/):
FROM python:3.10-slim AS base

LABEL version="1.2.0" \
      description="HELPDESK.AI backend — see root Dockerfile for full multi-stage build"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Build context is backend/ so requirements.txt is at the root of the context
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy backend source (entire build context = backend/ directory)
COPY . /app/backend

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
USER appuser

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD ["python", "backend/healthcheck.py"]

CMD ["uvicorn", "backend.main:app", \
     "--host", "0.0.0.0", \
     "--port", "7860", \
     "--workers", "1", \
     "--log-level", "info"]
