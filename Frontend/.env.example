# Example Frontend environment variables (DO NOT commit real credentials)
# Copy this to .env.local or .env and fill in real values.

VITE_BACKEND_URL=http://localhost:8000
VITE_AI_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.0-flash

# Supabase (client-side - use the ANON/public key here)
# Get these from Supabase Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_BACKEND_URL=http://localhost:8000
# Comma-separated Gemini model IDs used by the frontend fallback chain.
VITE_AI_GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
